# Exclude dev scaffolding from the VSIX. NOTE: the bundled analyzer lives under
# clarifydoc/** and MUST ship — do not add a bare `node_modules` glob here, only
# the root one below (clarifydoc/node_modules is not matched by `/node_modules`).
.vscode/**
.gitignore
src/**
scripts/**
test/**
out/test/**
/node_modules/**
esbuild.mjs
tsconfig.json
tsconfig.test.json
**/*.map
src/**/*.ts
.eslintrc*
*.vsix
INSTALL.md
# README media: the Marketplace page loads it from GitHub, so it needn't ship.
docs/**
.DS_Store
**/.DS_Store
vitest.config.mts
